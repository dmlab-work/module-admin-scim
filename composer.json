{
    "name": "dmlab/module-admin-scim",
    "description": "SCIM 2.0 provisioning server for Magento 2 admin users — RFC 7643/7644 endpoints so an IdP (Okta, Entra) can create, update and deactivate admin_user accounts and map groups to ACL roles, without anyone logging in.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.2.3",
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": ">=103.0",
        "magento/module-user": ">=101.2",
        "magento/module-authorization": ">=100.4",
        "magento/module-store": ">=101.1",
        "magento/module-config": ">=101.2",
        "magento/module-integration": ">=100.4",
        "magento/module-security": ">=100.4",
        "psr/log": "^2.0||^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\AdminScim\\": ""
        }
    }
}
