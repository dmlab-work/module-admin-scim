{
    "name": "dmlab/module-admin-scim",
    "description": "SCIM 2.0 provisioning server for Magento 2 admin users — RFC 7643/7644 endpoints so an IdP (Okta, Entra) can create, update and deactivate admin_user accounts and map groups to ACL roles, without anyone logging in.",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "scim",
        "scim 2.0",
        "provisioning",
        "deprovisioning",
        "offboarding",
        "admin users",
        "okta",
        "entra id",
        "azure ad"
    ],
    "homepage": "https://github.com/dmlab-work/module-admin-scim",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.2.3",
    "support": {
        "issues": "https://github.com/dmlab-work/module-admin-scim/issues",
        "source": "https://github.com/dmlab-work/module-admin-scim"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.7",
        "magento/module-user": "^101.2.7",
        "magento/module-authorization": "^100.4.7",
        "magento/module-store": "^101.1.7",
        "magento/module-config": "^101.2.7",
        "magento/module-integration": "^100.4.7",
        "magento/module-security": "^100.4.7",
        "psr/log": "^2.0||^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\AdminScim\\": ""
        }
    }
}
