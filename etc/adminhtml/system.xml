<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="dmlab" translate="label" sortOrder="400">
            <label>DMLab</label>
        </tab>
        <section id="dmlab_admin_scim" translate="label" type="text" sortOrder="20"
                 showInDefault="1" showInWebsite="0" showInStore="0">
            <class>separator-top</class>
            <label>Admin SCIM</label>
            <tab>dmlab</tab>
            <resource>DmLab_AdminScim::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="0" showInStore="0">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable Admin SCIM</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="provider" translate="label comment" type="select" sortOrder="15"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Provider</label>
                    <source_model>DmLab\AdminScim\Model\Config\Source\Provider</source_model>
                    <comment><![CDATA[IdP whose request quirks are normalized. Under "None", a single installed provider plugin still applies; with several installed, none runs until one is picked.]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="bearer_token" translate="label comment" type="obscure" sortOrder="20"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Bearer Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment><![CDATA[The provisioning credential the IdP presents as <code>Authorization: Bearer &lt;token&gt;</code>. Stored encrypted. Treat as a full admin-provisioning secret — use a long random value and rotate it.]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="request_limit" translate="label comment" type="text" sortOrder="25"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Request Limit</label>
                    <validate>validate-digits</validate>
                    <comment><![CDATA[Requests per minute the bearer token may make; beyond it the endpoint answers <code>429</code> with <code>Retry-After</code>. <code>0</code> disables the limit.]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="group_role_map" translate="label comment" type="textarea" sortOrder="30"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Group → Role Map</label>
                    <comment><![CDATA[One <code>displayName=role_id</code> per line, mapping a SCIM group to a Magento admin role id. A provisioned member gets the first matching role (admins hold a single role). Lines starting with <code>#</code> are ignored.]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="default_role" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Default Role Id</label>
                    <comment><![CDATA[ACL role id assigned when an admin's groups match no rule, including admins provisioned without groups. Leave empty to deny (no role).]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
