<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Provider-quirk seam: `admin-scim-<idp>` plugins di-merge their normalizer here. -->
    <type name="DmLab\AdminScim\Model\Normalization\RequestNormalizerChain">
        <arguments>
            <argument name="normalizers" xsi:type="array"/>
        </arguments>
    </type>
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="dmlab_admin_scim/general/bearer_token" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="DmLab\AdminScim\Logger\AuditHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/dmlab_admin_scim_audit.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="DmLab\AdminScim\Logger\Audit" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">dmlab_admin_scim_audit</argument>
            <argument name="handlers" xsi:type="array">
                <item name="audit" xsi:type="object">DmLab\AdminScim\Logger\AuditHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="DmLab\AdminScim\Model\Audit\AuditLogger">
        <arguments>
            <argument name="logger" xsi:type="object">DmLab\AdminScim\Logger\Audit</argument>
        </arguments>
    </type>
</config>
